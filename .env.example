# Example only: settings loading is not implemented before step 02.
# No secrets here. Copy to .env locally; never commit a populated .env.
# Variable names are proposed and must be confirmed in step 02.
# Blank directory values are intentional; no default paths are resolved yet.

LOCAL_TRANSCRIBER_DATA_DIR=
LOCAL_TRANSCRIBER_MODELS_DIR=
LOCAL_TRANSCRIBER_TEMP_DIR=
LOCAL_TRANSCRIBER_LOGS_DIR=

LOCAL_TRANSCRIBER_FFMPEG_PATH=ffmpeg
LOCAL_TRANSCRIBER_FFPROBE_PATH=ffprobe

LOCAL_TRANSCRIBER_POSTGRES_HOST=localhost
LOCAL_TRANSCRIBER_POSTGRES_PORT=5432
LOCAL_TRANSCRIBER_POSTGRES_DB=local_transcriber
LOCAL_TRANSCRIBER_POSTGRES_USER=
LOCAL_TRANSCRIBER_POSTGRES_PASSWORD=

# Future integration tests must use a separate database, never user data.
LOCAL_TRANSCRIBER_POSTGRES_TEST_DB=local_transcriber_test
