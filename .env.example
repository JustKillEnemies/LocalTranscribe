# Local settings: environment > this explicit/user .env > defaults.
# doctor --env-file .env reads this file explicitly; cwd .env is never implicit.
# Default user file: %LOCALAPPDATA%/LocalTranscriber/.env (APPDATA/home fallback).
# Blank values use defaults. No secrets here; never commit a populated .env.
# Windows paths: use forward slashes or SINGLE quotes, especially with spaces.
# Example syntax: LOCAL_TRANSCRIBER_DATA_DIR='C:/Users/USER/AppData/Local/LocalTranscriber'

LOCAL_TRANSCRIBER_DATA_DIR=
LOCAL_TRANSCRIBER_CACHE_DIR=
LOCAL_TRANSCRIBER_MODELS_DIR=
LOCAL_TRANSCRIBER_TEMP_DIR=
LOCAL_TRANSCRIBER_LOGS_DIR=

LOCAL_TRANSCRIBER_FFMPEG_PATH=ffmpeg
LOCAL_TRANSCRIBER_FFPROBE_PATH=ffprobe
LOCAL_TRANSCRIBER_POSTGRES_PROBE_PATH=pg_isready
LOCAL_TRANSCRIBER_NVIDIA_SMI_PATH=nvidia-smi
LOCAL_TRANSCRIBER_PROBE_TIMEOUT=5

LOCAL_TRANSCRIBER_POSTGRES_HOST=localhost
LOCAL_TRANSCRIBER_POSTGRES_PORT=5432
LOCAL_TRANSCRIBER_POSTGRES_DB=local_transcriber
LOCAL_TRANSCRIBER_POSTGRES_USER=
LOCAL_TRANSCRIBER_POSTGRES_PASSWORD=
# Optional local single-host postgres/postgresql URL. Entire DSN is secret.
# When provided, DSN host/port override separate host/port for readiness.
# Query options and fragments are rejected; readiness does not test authentication.
LOCAL_TRANSCRIBER_POSTGRES_DSN=
# Future DB integration tests must use a separate database, never user data.
LOCAL_TRANSCRIBER_POSTGRES_TEST_DB=local_transcriber_test

LOCAL_TRANSCRIBER_DEVICE=cuda
LOCAL_TRANSCRIBER_GPU_INDEX=0
LOCAL_TRANSCRIBER_MODEL_NAME=large-v3-turbo
# Default: MODELS_DIR/MODEL_NAME, a local converted CTranslate2 directory.
LOCAL_TRANSCRIBER_MODEL_PATH=
LOCAL_TRANSCRIBER_COMPUTE_TYPE=float16
